# Copie para .env e ajuste. Os valores de senha vêm do output do `npm run setup` (Terraform).
PALANTIR_ROLE=api
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://palantir:CHANGE_ME@localhost:5432/palantir
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PALANTIR_SERVICE_NAME=palantir
# Habilita as rotas /v1/channels/fake/* (somente ambiente local e testes).
PALANTIR_FAKE_CHANNEL=true
# Fração mínima dos termos da pergunta presentes na melhor mensagem (0 a 1). Abaixo disso a busca sinaliza
# low_confidence e o agente responde "não encontrei evidências suficientes".
PALANTIR_LOW_CONFIDENCE_THRESHOLD=0.5
# Canal WhatsApp (feature 003): processo próprio, `npm run dev:whatsapp`. Desligado por padrão.
PALANTIR_WHATSAPP_ENABLED=false
# Chave AES-256 da sessão do chip (32 bytes em base64). O `npm run setup` gera e preserva; trocar = parear de novo.
PALANTIR_WA_SESSION_KEY=
# Pasta do arquivo de sessão, fora do repositório. Vazio = ~/.palantir/whatsapp
PALANTIR_WA_SESSION_DIR=
PALANTIR_WHATSAPP_HEALTH_PORT=8081
# Captura ao vivo de grupos autorizados (feature 004): off (padrão), agent (o número do agente também captura)
# ou dedicated (segundo número, sessão própria em capture-session.enc). Grupos só com `npm run whatsapp:grupos`.
PALANTIR_WHATSAPP_CAPTURE=off
# Mídia e transcrição (feature 005). Tipos guardados (audio, image, document, video; vazio = nenhum). Hoje só áudio.
PALANTIR_MEDIA_STORE_KINDS=audio
# Chave AES-256 dos arquivos de mídia (32 bytes em base64). O `npm run setup` gera e preserva; trocar = perder os áudios.
PALANTIR_MEDIA_KEY=
# on = o worker transcreve; off = os áudios ficam guardados e pendentes.
PALANTIR_TRANSCRIPTION=on
# Motor: openai-compatible (Speaches local, subido pelo setup) ou fake (testes).
PALANTIR_TRANSCRIBER=openai-compatible
PALANTIR_TRANSCRIBER_URL=http://127.0.0.1:8090
# Modelo escolhido pela medição (`npm run eval:transcricao`).
PALANTIR_TRANSCRIBER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# true libera um motor fora desta máquina (SaaS): o áudio sai dela. Só por decisão explícita.
PALANTIR_TRANSCRIBER_ALLOW_REMOTE=false
PALANTIR_TRANSCRIBE_CONCURRENCY=1
# Chave da API do motor remoto (só com ALLOW_REMOTE=true); vazia no motor local. Nunca é logada.
PALANTIR_TRANSCRIBER_API_KEY=
# Busca pelo sentido (feature 007, ADR-0012). off desliga; openai-compatible fala com o motor local subido pelo setup
# (Text Embeddings Inference em :8091) ou com qualquer /v1/embeddings; voyage é o fornecedor indicado pela Anthropic.
PALANTIR_EMBEDDER=openai-compatible
PALANTIR_EMBEDDER_URL=http://127.0.0.1:8091
# Modelo escolhido pela medição (`npm run eval:busca -- medir`); trocar exige `npm run setup` (o motor local serve um por vez).
PALANTIR_EMBEDDER_MODEL=intfloat/multilingual-e5-base
PALANTIR_EMBEDDER_DIMENSIONS=768
# true pede ao serviço essa dimensão (OpenAI `dimensions`, Voyage `output_dimension`).
PALANTIR_EMBEDDER_REQUEST_DIMENSIONS=false
# Prefixos que alguns modelos pedem (a família e5 usa "query: " e "passage: ").
PALANTIR_EMBEDDER_QUERY_PREFIX="query: "
PALANTIR_EMBEDDER_DOCUMENT_PREFIX="passage: "
# true libera um serviço fora desta máquina: as mensagens saem dela. Só depois do ADR sobre dados de terceiros.
PALANTIR_EMBEDDER_ALLOW_REMOTE=false
PALANTIR_EMBEDDER_API_KEY=
# Semelhança mínima de sentido para citar (0 a 1): o "τ sugerido" da medição. Vazio = 0,5 com aviso.
PALANTIR_SEMANTIC_MIN_SIMILARITY=
# Semelhança mínima para palavras com erro de digitação (trigramas).
PALANTIR_TYPO_MIN_SIMILARITY=0.6
# on (padrão) liga a busca por palavra parecida; off volta à busca por palavra exata da S5.
PALANTIR_TYPO_SEARCH=on
# Verificador externo opcional (Jev, TypeSafe): off, typesafe ou fake (testes). Perguntas e trechos saem desta máquina.
PALANTIR_VERIFIER=off
PALANTIR_VERIFIER_ALLOW_REMOTE=false
PALANTIR_VERIFIER_MODEL=jev-1.14.0
PALANTIR_VERIFIER_MIN_PROBABILITY=0.7
TYPESAFE_API_KEY=
