{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palantir.local/contracts/channel/agent-reply.schema.json",
  "title": "AgentReply",
  "description": "Resposta neutra do agente; cada adaptador renderiza para o seu canal (ADR-0004). 1.4.0 adiciona media, o anexo por referência.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "citations",
    "outcome"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "answered",
        "no_evidence",
        "error",
        "help"
      ]
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "title": "Citation",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "messageId",
          "author",
          "sourceTitle",
          "sentAt"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "audio",
              "image",
              "document",
              "link"
            ],
            "description": "Tipo da mensagem citada (1.3.0)."
          },
          "audioStartS": {
            "type": "number",
            "minimum": 0,
            "description": "Início do trecho citado no áudio, em segundos (1.3.0)."
          },
          "audioEndS": {
            "type": "number",
            "minimum": 0,
            "description": "Fim do trecho citado no áudio, em segundos (1.3.0)."
          }
        },
        "dependentRequired": {
          "audioStartS": [
            "audioEndS"
          ],
          "audioEndS": [
            "audioStartS"
          ]
        }
      }
    },
    "media": {
      "type": "array",
      "maxItems": 1,
      "description": "Anexo entregue depois do texto, por referência (1.4.0). Nunca leva bytes: o adaptador busca o arquivo pelo OutboundMediaLoader.",
      "items": {
        "title": "ReplyMedia",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "mimeType",
          "sizeBytes",
          "failureText"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "audio"
            ]
          },
          "ref": {
            "type": "string",
            "format": "uuid",
            "description": "Id do anexo (attachments.id)."
          },
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216,
            "description": "Até 16 MB, o limite de áudio do WhatsApp."
          },
          "failureText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Enviado pelo adaptador quando não consegue entregar o anexo."
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "outcome": {
        "const": "answered"
      }
    }
  },
  "then": {
    "properties": {
      "citations": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
