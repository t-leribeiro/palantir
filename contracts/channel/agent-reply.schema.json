{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palantir.local/contracts/channel/agent-reply.schema.json",
  "title": "AgentReply",
  "description": "Resposta neutra do agente; cada adaptador renderiza para o seu canal (ADR-0004).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "citations",
    "outcome"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "answered",
        "no_evidence",
        "error"
      ]
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "title": "Citation",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "messageId",
          "author",
          "sourceTitle",
          "sentAt"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "outcome": {
        "const": "answered"
      }
    }
  },
  "then": {
    "properties": {
      "citations": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
