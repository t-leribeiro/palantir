{
  "uid": "palantir-whatsapp",
  "title": "Palantír / WhatsApp (número do agente)",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "palantir",
    "whatsapp"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estado da sessão do agente",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "pairing",
                  "color": "yellow"
                },
                "2": {
                  "text": "connected",
                  "color": "green"
                },
                "3": {
                  "text": "reconnecting",
                  "color": "orange"
                },
                "4": {
                  "text": "logged_out",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(whatsapp_session_state{role=\"agent\",state=\"pairing\"}) * 1 + max(whatsapp_session_state{role=\"agent\",state=\"connected\"}) * 2 + max(whatsapp_session_state{role=\"agent\",state=\"reconnecting\"}) * 3 + max(whatsapp_session_state{role=\"agent\",state=\"logged_out\"}) * 4",
          "legendFormat": "estado"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reconexões (última hora)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(whatsapp_reconnects_total[1h]))",
          "legendFormat": "reconexões"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Remetentes desconhecidos (última hora)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(whatsapp_unknown_senders_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Falhas (última hora)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(whatsapp_send_failures_total[1h])) + sum(increase(whatsapp_handler_failures_total[1h]))",
          "legendFormat": "falhas"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mensagens recebidas por tipo (por minuto)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(whatsapp_messages_received_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Respostas e partes enviadas (por minuto)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(whatsapp_replies_sent_total[5m])) * 60",
          "legendFormat": "respostas"
        },
        {
          "refId": "B",
          "expr": "sum(rate(whatsapp_reply_parts_total[5m])) * 60",
          "legendFormat": "partes"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latência do agente P95 (s)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_ask_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Estado da captura (sessão de captura no modo de dois números)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(whatsapp_session_state{role=\"capture\",state=\"connected\"}) * 2 + max(whatsapp_session_state{role=\"capture\",state=\"reconnecting\"}) * 3 + max(whatsapp_session_state{role=\"capture\",state=\"logged_out\"}) * 4 + max(whatsapp_session_state{role=\"capture\",state=\"pairing\"}) * 1",
          "legendFormat": "captura"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mensagens capturadas por resultado (por minuto)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(whatsapp_captured_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Descartadas pela captura por motivo (última hora)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(whatsapp_capture_discarded_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Mídias ignoradas por tipo (última hora, S4)",
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(whatsapp_capture_ignored_media_total[1h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Reconciliadas ao vivo × importadas (última hora)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ingestion_messages_total{outcome=\"reconciled\"}[1h]))",
          "legendFormat": "reconciliadas"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Áudios enviados de volta ao dono por resultado",
      "description": "sent: entregue como mensagem de voz; failed: o loader ou o envio falharam e foi o texto de falha; missing: sem armazenamento configurado.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(channel_media_sent_total{adapter=\"whatsapp\"}[1h]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
