{
  "name": "palantir",
  "version": "0.1.0",
  "private": true,
  "description": "Palantír, Personal Knowledge Agent: memória pessoal sobre conversas, WhatsApp-first, not WhatsApp-only.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prepare": "lefthook install",
    "doctor": "node scripts/doctor.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "complexity:check": "node scripts/complexity.mjs check",
    "complexity:report": "node scripts/complexity.mjs report",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project architecture",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run --project e2e",
    "test:mutation": "stryker run",
    "test": "vitest run --project unit --project architecture --project contract",
    "setup": "node scripts/infra.mjs apply",
    "teardown": "node scripts/infra.mjs destroy",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/main/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/main/seed.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/main/api.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/main/worker.ts",
    "security": "node scripts/security.mjs",
    "eval": "node --import tsx scripts/eval.ts",
    "dor": "node scripts/dor.mjs",
    "test:load": "node --import tsx test/load/ingestion.load.ts",
    "import": "node --env-file-if-exists=.env --import tsx src/main/import.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "json-schema-to-typescript": "15.0.4",
    "lefthook": "2.2.2",
    "testcontainers": "11.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1",
    "yazl": "3.3.1"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "node-pg-migrate": "8.0.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "pino": "10.4.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
